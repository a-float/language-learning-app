{
  "collection": "user_vocabulary_progress",
  "name": "user_vocabulary_progress",
  "type": "base",
  "schema": [
    { "name": "user_id", "type": "relation", "required": true, "options": { "collectionId": "users" } },
    { "name": "vocabulary_id", "type": "relation", "required": true, "options": { "collectionId": "vocabulary" } },
    { "name": "knowledge_level", "type": "number", "required": true, "options": { "min": 0, "max": 5 } },
    { "name": "last_reviewed", "type": "date", "required": false },
    { "name": "review_count", "type": "number", "required": false }
  ],
  "indexes": [
    ["user_id", "vocabulary_id"]
  ]
}
